# EtijahFly monorepo - environment overview (illustrative values only; never commit real secrets).
# Each app reads its own file:
#   apps/backend/.env            (copy apps/backend/.env.example)   - Laravel API, the only holder of secrets
#   apps/partner-portal/.env     (copy apps/partner-portal/.env.example)
#   apps/admin-portal/.env.local (copy apps/admin-portal/.env.example)
#   infrastructure/.env.production for docker compose

# ---- Laravel API (server only) ----
APP_KEY=base64:generate-with-php-artisan-key-generate
DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-server-only>
AIRLINES_API_KEY=<omkar-cloud-airlines-api-key>
REDIS_PASSWORD=<redis-password>

PORTAL_PROXY_SECRET=<long-random-string-shared-with-both-portals>

# ---- Portals (server side of each portal; never NEXT_PUBLIC_/NUXT_PUBLIC_ for these) ----
NUXT_API_BASE=http://127.0.0.1:8000/api/v1          # partner portal -> API
NUXT_PORTAL_PROXY_SECRET=<same-as-PORTAL_PROXY_SECRET>
NUXT_COOKIE_SECURE=true                              # production (HTTPS)
API_BASE_URL=http://127.0.0.1:8000/api/v1           # admin portal -> API
PORTAL_PROXY_SECRET=<same-value>                     # admin portal

# Production layout: portals on Vercel, API on Render - see docs/deployment-vercel-render.md and render.yaml
