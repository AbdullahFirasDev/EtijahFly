# Copy to infrastructure/.env.production and fill in. Never commit the real file.
APP_NAME=EtijahFly
APP_KEY=
APP_URL=http://web:8080
PARTNER_PORTAL_URL=https://portal.example.com
ADMIN_PORTAL_URL=https://admin.example.com
CORS_ALLOWED_ORIGINS=https://portal.example.com,https://admin.example.com
APP_LOCALE=ar

DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

REDIS_PASSWORD=change-me

SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com

AIRLINES_API_KEY=
AIRLINES_API_MONTHLY_BUDGET=90
MOCK_FLIGHT_PROVIDER_ENABLED=false
