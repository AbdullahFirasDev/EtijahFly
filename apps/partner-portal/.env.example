# Server-side only (Nitro). The browser never sees these values or the API token.
NUXT_API_BASE=http://127.0.0.1:8000/api/v1
# true behind HTTPS (production)
NUXT_COOKIE_SECURE=false
NUXT_PUBLIC_PLATFORM_NAME=EtijahFly
# Same value as PORTAL_PROXY_SECRET on the API. Needed when the API runs on a separate host
# (production on Vercel + Render) so rate limits and audit logs see the real user IP.
NUXT_PORTAL_PROXY_SECRET=
