APP_NAME=EtijahFly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Frontends (used for links in e-mails and for CORS). The browser never talks to the
# API directly in the default setup: both portals proxy through their own server (BFF).
PARTNER_PORTAL_URL=http://localhost:3000
ADMIN_PORTAL_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Shared secret with both portals: lets the API trust the end-user IP they forward when it is
# hosted separately (e.g. Render). Generate a long random value; empty = disabled.
PORTAL_PROXY_SECRET=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------------
# Local: PostgreSQL 17 started by infrastructure/local/services.ps1
# Supabase: use the *session pooler* (port 5432) or direct connection string from
# Project Settings -> Database. Laravel needs session semantics (advisory/row locks
# inside transactions), so do NOT use the transaction pooler (port 6543) for the app.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54322
DB_DATABASE=etijahfly
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer
# DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Redis / Queue / Cache ----------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# --- Mail ----------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@etijahfly.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Auth ------------------------------------------------------------------------
# Absolute token lifetime and idle timeout (minutes).
AUTH_TOKEN_TTL_MINUTES=480
AUTH_TOKEN_IDLE_MINUTES=120

# --- File storage (logos, booking documents, payment proofs) -------------------
# local    -> storage/app/private, served via short-lived signed URLs
# supabase -> Supabase Storage private buckets, served via signed URLs
FILE_STORAGE_DRIVER=local
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-side only. Never expose this key to a browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_DOCUMENTS=documents
SUPABASE_BUCKET_BRANDING=branding
SUPABASE_BUCKET_PAYMENT_PROOFS=payment-proofs
FILE_SIGNED_URL_TTL_SECONDS=120

# --- Flight / airline providers -----------------------------------------------
# Airline reference data (omkarcloud). Free tier = 100 requests / month.
AIRLINES_API_BASE_URL=https://airlines-api.omkar.cloud
AIRLINES_API_KEY=
AIRLINES_API_MONTHLY_BUDGET=90
AIRLINES_API_TIMEOUT=10

# Simulated booking provider for development and automated tests. Its offers are
# flagged as test data everywhere. Keep disabled in production.
MOCK_FLIGHT_PROVIDER_ENABLED=true

# Opt-in live tests against third-party APIs (consume real quota).
RUN_EXTERNAL_TESTS=false

# --- Development seed ----------------------------------------------------------
# Password for the demo users created by `php artisan db:seed` (local/testing only).
# Leave empty to generate a random one that is printed once.
DEV_SEED_PASSWORD=
