{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "admin-portal": {
      "root": "admin-portal",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "npm run build"
    },
    "partner-portal": {
      "root": "partner-portal",
      "framework": "nuxtjs",
      "installCommand": "cd ../.. && npm ci",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "pre": "admin." } }],
      "destination": { "service": "admin-portal" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "partner-portal" }
    }
  ]
}
