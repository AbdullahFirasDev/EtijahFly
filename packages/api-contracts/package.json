{
  "name": "@etijahfly/api-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAPI document of the EtijahFly API (generated by Scramble) and the shared TypeScript contracts used by both portals.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
